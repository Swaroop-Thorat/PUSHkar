{
  "manifest_version": 3,
  "name": "PUSHkar",
  "version": "1.0.0",
  "description": "Solve it. PUSHkar. ⚡ — Auto push your coding solutions to GitHub",
  "author": "Swaroop",
  "homepage_url": "https://github.com/swaroop/pushkar",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PUSHkar ⚡"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.codeforces.com/*",
        "*://*.codechef.com/*",
        "*://*.hackerrank.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://*.geeksforgeeks.org/*",
    "*://*.codeforces.com/*",
    "*://*.codechef.com/*",
    "*://*.hackerrank.com/*",
    "http://localhost:3000/*"
  ]
}
